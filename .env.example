# ==============================================================================
# karriere.bad-energie.de – Umgebungsvariablen
# ==============================================================================
# Kopie als .env.local anlegen (lokal) bzw. im Vercel-Dashboard pflegen.
# In diese Datei gehören NIE echte Schlüssel: sie liegt öffentlich im Git.
# Platzhalter wie "re_123456789", "your_…" oder leere Werte gelten als nicht gesetzt.
# Bei den Variablen, die lib/env.ts prüft, wird ein umschließendes Paar Anführungszeichen
# (z. B. im Vercel-Dashboard mitkopiert) entfernt. APP_URL und die Maps-Variablen trotzdem ohne
# Anführungszeichen eintragen: Sie werden zusätzlich ungeprüft gelesen (Metadaten, Sitemap, Karte).
# Validierung und Fallbacks: lib/env.ts · Prüfen nach dem Deploy: GET /api/status

# APP_URL: Öffentliche Basis-URL ohne abschließenden Slash (Canonicals, Links, Sitemap).
# Standard: https://karriere.bad-energie.de
APP_URL="https://karriere.bad-energie.de"

# ==============================================================================
# E-MAIL-VERSAND (Resend, https://resend.com)
# ==============================================================================
# RESEND_API_KEY: API-Key von Resend. Pflicht in Production. Nur druckbare ASCII-Zeichen
# (beim Kopieren keine Leer- oder unsichtbaren Zeichen mitnehmen). Fehlt er, startet der
# Server trotzdem und protokolliert die Lücke (instrumentation.ts); die Bewerbungs-API
# antwortet dann mit 503 statt eines Scheinerfolgs, die Seite bietet Telefon und WhatsApp an.
RESEND_API_KEY="re_123456789"

# RESEND_FROM_EMAIL: Optional. Ohne Wert gilt der Standardabsender
# "Bad und Energie Karriere <bewerbung@karriere.bad-energie.de>": Nur karriere.bad-energie.de
# ist im DNS für Resend eingerichtet (geprüft 2026-10-10), bad-energie.de nicht. Ein eigener
# Wert muss auf einer in Resend verifizierten Domain liegen. Kein Ersatz auf fremden Domains
# (auch nicht onboarding@resend.dev).
RESEND_FROM_EMAIL=""

# CONTACT_NOTIFICATION_EMAIL: Empfänger für neue Bewerbungen und Anfragen (Team).
# Standard: info@bad-energie.de
CONTACT_NOTIFICATION_EMAIL="info@bad-energie.de"

# EMAIL_SIMULATION: Nur lokal und für E2E-Tests. "true" verschickt keine Mails,
# sondern simuliert den Versand (auch bei `next start`). Auf Vercel Production
# wird die Simulation immer abgelehnt. Mit `next dev` wird ohne Resend-Key
# ohnehin simuliert.
EMAIL_SIMULATION="false"

# ==============================================================================
# SICHERHEIT (HMAC-Geheimnisse, je mind. 32 Zeichen, z. B. `openssl rand -hex 32`)
# ==============================================================================
# Empfohlen: eigene Werte. Fehlen sie oder sind sie ungültig, werden sie per HMAC-SHA256
# aus RESEND_API_KEY abgeleitet (sonst aus dem Supabase-Server-Key), je Zweck ein eigener
# Wert, auf allen Server-Instanzen gleich. Ein neuer Hauptschlüssel ändert die abgeleiteten
# Werte: offene Ergänzungs-Links der letzten 14 Tage werden dann ungültig.
# Gibt es weder einen eigenen Wert noch einen Hauptschlüssel, antworten die Formular-APIs
# mit 503; der Server startet trotzdem und protokolliert die Lücke (instrumentation.ts).
# Nur `next dev`, Tests und ALLOW_DEV_SECRETS nutzen einen festen Dev-Wert.

# IP_HASH_SALT: Salt für gehashte IP-Adressen (Rate-Limit).
IP_HASH_SALT="your_random_secret_min_32_chars"

# APPLICATION_TOKEN_SECRET: HMAC-Secret für Bewerbungsnummer und die Links, mit denen
# Bewerber Angaben nachreichen. Ein Wechsel macht offene Links ungültig.
APPLICATION_TOKEN_SECRET="your_random_secret_min_32_chars"

# ALLOW_DEV_SECRETS: Nur für lokale E2E-Läufe mit `next start`. "true" erlaubt
# den festen Dev-Wert für fehlende Geheimnisse; auf Vercel Production wirkungslos.
ALLOW_DEV_SECRETS="false"

# ==============================================================================
# INDEXNOW (Bing, Yandex, Seznam – https://www.indexnow.org)
# ==============================================================================
# INDEXNOW_KEY: Öffentlicher Prüfschlüssel (per Protokoll kein Geheimnis), 8–128
# Zeichen aus a–z, A–Z, 0–9 und "-". Kommt nur aus der Umgebung; ohne Wert ist das
# Einreichen deaktiviert (HTTP 503). Es muss eine Datei public/<key>.txt mit dem Key
# als Inhalt geben; im Repo liegt die Prüfdatei des bisher genutzten Keys.
INDEXNOW_KEY=""

# INDEXNOW_SUBMIT_TOKEN: Geheimes Bearer-Token für POST /api/indexnow
# (Header "Authorization: Bearer <token>"), mind. 32 Zeichen.
# Ohne Wert ist das Einreichen deaktiviert (HTTP 503).
INDEXNOW_SUBMIT_TOKEN=""

# ==============================================================================
# GOOGLE MAPS PLATFORM (https://console.cloud.google.com/google/maps-apis)
# ==============================================================================
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: Browser-Key der Maps JavaScript API.
# Wird öffentlich ausgeliefert, daher in der Cloud Console auf die Domain beschränken.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# GOOGLE_MAPS_API_KEY: Alternative ohne NEXT_PUBLIC_-Präfix (über /api/maps/config).
GOOGLE_MAPS_API_KEY=""

# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID: Optional, für Cloud-basiertes Karten-Styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# ==============================================================================
# BEWERBERDATENBANK (Supabase, Phase 2b)
# ==============================================================================
# Sind URL und Server-Key gesetzt, speichert Vercel Production jede Bewerbung und die
# Ergänzungen dazu zusätzlich in der Datenbank (rpc_submit_application, rpc_submit_follow_up)
# und schickt danach dieselben Mails wie bisher. Fällt die Datenbank aus, geht die
# Bewerbung als Not-E-Mail ans Team. Fehlt einer der beiden Werte, bleibt es beim E-Mail-Versand.

# SUPABASE_URL: Projekt-URL (https://<ref>.supabase.co, Region Frankfurt).
# Alternativ wird NEXT_PUBLIC_SUPABASE_URL gelesen (Name der Vercel-Integration).
SUPABASE_URL=""

# SUPABASE_SECRET_KEY: Secret Key (sb_secret_…), nur serverseitig. Alternativ wird
# SUPABASE_SERVICE_ROLE_KEY gelesen (alter JWT, nur mit Rolle service_role).
# Publishable- und anon-Keys werden abgelehnt und beim Start als „ungültig“ gemeldet.
SUPABASE_SECRET_KEY="your_supabase_secret_key"

# APPLICATION_SINK: Ziel der Bewerbungen.
#   auto (Standard, auch bei leerem Wert): Datenbank und E-Mail nur auf Vercel Production;
#        Preview, `next start`, lokal und Tests schreiben nie in das eine Supabase-Projekt.
#   supabase: Datenbank auch außerhalb von Production (nur wenn URL und Key gesetzt sind).
#   email: nur E-Mail, Notschalter (wirkt wie jede Änderung erst nach einem neuen Deploy).
APPLICATION_SINK=""

# ------------------------------------------------------------------------------
# Spätere Scheiben von Phase 2 (noch nicht aktiv)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Publishable Key (sb_publishable_…) für das Cockpit (2d).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# ADMIN_EMAIL_ALLOWLIST: Kommagetrennte E-Mail-Adressen mit Cockpit-Zugang (2d).
# ADMIN_EMAIL_ALLOWLIST="your_name@example.com"

# CRON_SECRET: Bearer-Token, mit dem Vercel Cron /api/cron/daily aufruft (ursprünglicher Plan;
# laut ROADMAP §8.1 übernimmt in 2c pg_cron die Löschfristen, ob die Variable noch nötig ist, klärt 2c).
# CRON_SECRET="your_random_secret_min_32_chars"
