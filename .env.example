# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://karriere.bad-energie.de"

# ==============================================================================
# RESEND E-MAIL SERVICE CONFIGURATION (https://resend.com)
# ==============================================================================
# RESEND_API_KEY: Dein API-Key von Resend
# Wenn nicht gesetzt, läuft das Portal im Simulation-Mode (Logs in Serverkonsole).
RESEND_API_KEY="re_4DEmhVym_4QwmerzCp2Pk92tiutD7zaQP"

# RESEND_FROM_EMAIL: Verifizierte Absender-Adresse (karriere.bad-energie.de ist in Resend aktiv verifiziert).
RESEND_FROM_EMAIL="Bad und Energie Karriere <bewerbung@karriere.bad-energie.de>"

# CONTACT_NOTIFICATION_EMAIL: Zieladresse für eingehende Leads & Bewerbungen (Chef/Team).
# Standard: "info@bad-energie.de"
CONTACT_NOTIFICATION_EMAIL="info@bad-energie.de"

# ==============================================================================
# BING WEBMASTER TOOLS / INDEXNOW (https://www.bing.com/indexnow)
# ==============================================================================
NEXT_PUBLIC_INDEXNOW_KEY="298d966b7e4f4a43981cb8e30da6b5b5"

# ==============================================================================
# GOOGLE MAPS PLATFORM (https://console.cloud.google.com/google/maps-apis)
# ==============================================================================
# Plug & Play: Trage deinen Google Maps JavaScript API Key einfach hier in
# .env.local oder im Vercel Dashboard als Environment Variable ein.
# Beide Bezeichnungen werden vom System vollautomatisch erkannt:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Alternativ (auch ohne NEXT_PUBLIC_ Präfix unterstützt):
GOOGLE_MAPS_API_KEY=""

# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID: Optional für Cloud-basiertes Karten-Styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""


