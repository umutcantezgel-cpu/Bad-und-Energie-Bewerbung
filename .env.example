# ==============================================================================
# karriere.bad-energie.de – Umgebungsvariablen
# ==============================================================================
# Kopie als .env.local anlegen (lokal) bzw. im Vercel-Dashboard pflegen.
# In diese Datei gehören NIE echte Schlüssel: sie liegt öffentlich im Git.
# Platzhalter wie "re_123456789", "your_…" oder leere Werte gelten als nicht gesetzt.
# Validierung und Fallbacks: lib/env.ts

# APP_URL: Öffentliche Basis-URL ohne abschließenden Slash (Canonicals, Links, Sitemap).
# Standard: https://karriere.bad-energie.de
APP_URL="https://karriere.bad-energie.de"

# ==============================================================================
# E-MAIL-VERSAND (Resend, https://resend.com)
# ==============================================================================
# RESEND_API_KEY: API-Key von Resend. Pflicht in Production; auf Vercel Production
# bricht ohne ihn der Serverstart ab (instrumentation.ts). Lokal mit `next start`
# meldet die Bewerbungs-API dann 503 statt eines Scheinerfolgs.
RESEND_API_KEY="re_123456789"

# RESEND_FROM_EMAIL: Verifizierter Absender. Pflicht in Production, wie RESEND_API_KEY.
# Es gibt keinen Ersatzabsender (auch nicht onboarding@resend.dev): ohne Wert wird
# lokal nur simuliert.
RESEND_FROM_EMAIL="Bad und Energie Karriere <bewerbung@karriere.bad-energie.de>"

# CONTACT_NOTIFICATION_EMAIL: Empfänger für neue Bewerbungen und Anfragen (Team).
# Standard: info@bad-energie.de
CONTACT_NOTIFICATION_EMAIL="info@bad-energie.de"

# EMAIL_SIMULATION: Nur lokal und für E2E-Tests. "true" verschickt keine Mails,
# sondern simuliert den Versand (auch bei `next start`). Auf Vercel Production
# wird die Simulation immer abgelehnt. Mit `next dev` wird ohne Resend-Key
# ohnehin simuliert.
EMAIL_SIMULATION="false"

# ==============================================================================
# SICHERHEIT (HMAC-Geheimnisse, je mind. 32 Zeichen, z. B. `openssl rand -hex 32`)
# ==============================================================================
# Pflicht in jedem Production-Build (Vercel Production und Preview, Self-Hosting).
# Fehlen sie, antworten die Formular-APIs mit 503; auf Vercel
# Production startet der Server nicht. Nur `next dev` und Tests nutzen einen
# festen Dev-Wert.

# IP_HASH_SALT: Salt für gehashte IP-Adressen (Rate-Limit).
IP_HASH_SALT="your_random_secret_min_32_chars"

# APPLICATION_TOKEN_SECRET: HMAC-Secret für die Links, mit denen Bewerber
# Unterlagen nachreichen. Ein Wechsel macht offene Links ungültig.
APPLICATION_TOKEN_SECRET="your_random_secret_min_32_chars"

# ALLOW_DEV_SECRETS: Nur für lokale E2E-Läufe mit `next start`. "true" erlaubt
# den festen Dev-Wert für fehlende Geheimnisse; auf Vercel Production wirkungslos.
ALLOW_DEV_SECRETS="false"

# ==============================================================================
# INDEXNOW (Bing, Yandex, Seznam – https://www.indexnow.org)
# ==============================================================================
# INDEXNOW_KEY: Öffentlicher Prüfschlüssel (per Protokoll kein Geheimnis), 8–128
# Zeichen aus a–z, A–Z, 0–9 und "-". Kommt nur aus der Umgebung; ohne Wert ist das
# Einreichen deaktiviert (HTTP 503). Es muss eine Datei public/<key>.txt mit dem Key
# als Inhalt geben; im Repo liegt die Prüfdatei des bisher genutzten Keys.
INDEXNOW_KEY=""

# INDEXNOW_SUBMIT_TOKEN: Geheimes Bearer-Token für POST /api/indexnow
# (Header "Authorization: Bearer <token>"), mind. 32 Zeichen.
# Ohne Wert ist das Einreichen deaktiviert (HTTP 503).
INDEXNOW_SUBMIT_TOKEN=""

# ==============================================================================
# GOOGLE MAPS PLATFORM (https://console.cloud.google.com/google/maps-apis)
# ==============================================================================
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: Browser-Key der Maps JavaScript API.
# Wird öffentlich ausgeliefert, daher in der Cloud Console auf die Domain beschränken.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# GOOGLE_MAPS_API_KEY: Alternative ohne NEXT_PUBLIC_-Präfix (über /api/maps/config).
GOOGLE_MAPS_API_KEY=""

# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID: Optional, für Cloud-basiertes Karten-Styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# ==============================================================================
# PHASE 2: ATS AUF SUPABASE (noch nicht aktiv)
# ==============================================================================
# NEXT_PUBLIC_SUPABASE_URL: Projekt-URL (Region Frankfurt).
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Öffentlicher Publishable Key (sb_publishable_…).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# SUPABASE_SECRET_KEY: Secret Key (sb_secret_…), nur serverseitig verwenden.
# SUPABASE_SECRET_KEY="your_supabase_secret_key"

# ADMIN_EMAIL_ALLOWLIST: Kommagetrennte E-Mail-Adressen mit Cockpit-Zugang.
# ADMIN_EMAIL_ALLOWLIST="your_name@example.com"

# CRON_SECRET: Bearer-Token, mit dem Vercel Cron /api/cron/daily aufruft.
# CRON_SECRET="your_random_secret_min_32_chars"
