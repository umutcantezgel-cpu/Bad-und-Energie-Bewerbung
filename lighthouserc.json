{
  "ci": {
    "collect": {
      "startServerCommand": "bunx next start -p 3410",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3410/",
        "http://localhost:3410/jobs",
        "http://localhost:3410/jobs/anlagenmechaniker-shk-wetzlar",
        "http://localhost:3410/bewerbung?stelle=anlagenmechaniker-shk-wetzlar"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }]
          }
        },
        {
          "matchingUrlPattern": "^((?!/bewerbung).)*$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "/bewerbung",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
